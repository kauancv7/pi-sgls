{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "SUA_CHAVE_SUPER_SECRETA_COM_32_CHARS_OU_MAIS",
    "Issuer": "MinhaLoja.Api",
    "Audience": "MinhaLoja.Web"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sgls;Username=postgres;Password=postgres123"
  },
  "ImageStorage": {
    "UploadsFolder": "Uploads",
    "RequestPath": "/uploads"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "Muitas requisições. Tente novamente em {0} segundos.",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "post:/api/auth/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/v1/auth/cliente/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/pedidos",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "post:/api/images/upload",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*:/api/*",
        "Period": "1m",
        "Limit": 120
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  }
}
